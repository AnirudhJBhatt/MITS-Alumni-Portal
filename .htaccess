# ==============================================================================
# MITS Connect - Enterprise Production .htaccess for Hostinger VPS (Apache 2.4+)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER HARDENING & DIRECTORY OPTIONS
# ------------------------------------------------------------------------------
# Disable directory listing (prevents directory browsing if index is absent)
Options -Indexes -MultiViews

# Follow symbolic links (required for mod_rewrite)
Options +FollowSymLinks

# Disable server signature (reduces server version fingerprinting)
ServerSignature Off

# Set default character encoding
AddDefaultCharset UTF-8

# Limit request body size to 10 MB (prevents memory exhaustion from huge uploads)
LimitRequestBody 10485760

# ------------------------------------------------------------------------------
# 2. RESTRICT DANGEROUS & UNNECESSARY HTTP METHODS
# ------------------------------------------------------------------------------
# Block TRACE and TRACK (prevents Cross-Site Tracing attacks)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|CONNECT) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# ------------------------------------------------------------------------------
# 3. BLOCK ACCESS TO SENSITIVE FILES & EXTENSIONS
# ------------------------------------------------------------------------------
# Block dotfiles (.git, .env, .htaccess, .htpasswd, etc.) except .well-known (for SSL)
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule "(^|/)\.(?!well-known)" - [F,NC,L]
</IfModule>

# Block access to database backups, documentation, templates, and config files
<FilesMatch "(?i)\.(sql|bak|backup|old|orig|save|swp|log|ini|conf|cfg|env|sh|bash|bat|cmd|md|lock|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 4. BLOCK DIRECT HTTP ACCESS TO INTERNAL BACKEND DIRECTORIES
# ------------------------------------------------------------------------------
# Disallow direct browser requests to /database/, /config/, and /includes/
# (PHP filesystem includes via require/include remain completely unaffected)
<IfModule mod_rewrite.c>
    RewriteRule ^(database|config|includes)(/.*)?$ - [F,NC,L]
</IfModule>

# ------------------------------------------------------------------------------
# 5. HARDEN UPLOADS DIRECTORY (DEFENSE-IN-DEPTH)
# ------------------------------------------------------------------------------
# Prevent execution of any scripts in the uploads directory
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|exe|sh|bat|cmd|jsp|asp|aspx)$ - [F,NC,L]
</IfModule>

# ------------------------------------------------------------------------------
# 6. FILTER COMMON WEB EXPLOIT ATTEMPTS & MALICIOUS QUERY STRINGS
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    # Block null byte injections (%00)
    RewriteCond %{QUERY_STRING} (?:%00|\\x00) [NC,OR]

    # Block directory traversal attempts (../, %2e%2e)
    RewriteCond %{QUERY_STRING} (?:(\.\./|\.\.\\|%2e%2e)) [NC,OR]

    # Block PHP wrapper and stream injection (php://, data:, file://)
    RewriteCond %{QUERY_STRING} (?:php|data|file|glob|phar|zip):// [NC,OR]

    # Block global variable poisoning and base64 injection in query string
    RewriteCond %{QUERY_STRING} (?:base64_(?:encode|decode)|GLOBALS|_REQUEST|_SERVER) [NC,OR]

    # Block proc/self/environ / system path traversal attempts
    RewriteCond %{QUERY_STRING} (?:/proc/self/(?:environ|cmdline)|/etc/passwd) [NC,OR]

    # Block script tag injection in query string (<script>, %3Cscript%3E)
    RewriteCond %{QUERY_STRING} (?:<script.*>|%3Cscript.*%3E) [NC,OR]

    # Block SQL injection probe patterns in query string
    RewriteCond %{QUERY_STRING} (?:concat.*\()|(?:union.*select)|(?:benchmark.*\()|(?:sleep\() [NC]
    RewriteRule .* - [F,L]
</IfModule>

# ------------------------------------------------------------------------------
# 7. AUTOMATIC HTTPS REDIRECTION (SSL ENFORCEMENT)
# ------------------------------------------------------------------------------
# Redirects all HTTP traffic to HTTPS on production (excludes localhost for local testing)
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------------------
# 8. HIDE .PHP EXTENSION & CLEAN URL ROUTING
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    # 8.1. Redirect /index.php to / (canonical homepage URL)
    # Preserves POST requests (e.g. form submissions)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?]*)/index\.php [NC]
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteRule ^ %1/ [R=301,L]

    # 8.2. External 301 Redirect: Strip .php from browser address bar
    # E.g. /feed.php -> /feed, /auth/login.php -> /auth/login
    # Excludes /api/ endpoints and POST requests
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?]+)\.php [NC]
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{REQUEST_URI} !/api/ [NC]
    RewriteRule ^ %1 [R=301,L]

    # 8.3. Remove trailing slashes from non-directories (e.g. /feed/ -> /feed)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?]+)/(\?|\s) [NC]
    RewriteRule ^ %1 [R=301,L]

    # 8.4. Internal URL Routing: Silently map clean URL /name to /name.php
    # E.g. /feed -> feed.php, /auth/login -> auth/login.php, /jobs -> jobs.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

# ------------------------------------------------------------------------------
# 9. HTTP SECURITY HEADERS
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent clickjacking attacks (pages cannot be framed externally)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Cross-site scripting protection filter for older browsers
    Header always set X-XSS-Protection "1; mode=block"

    # Strict referrer policy (sends referrer only on HTTPS -> HTTPS)
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict unnecessary browser features
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # HTTP Strict Transport Security (HSTS) - Enforce HTTPS for 1 year on production
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # Remove PHP and server disclosure headers
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ------------------------------------------------------------------------------
# 10. GZIP / DEFLATE ASSET COMPRESSION (BANDWIDTH OPTIMIZATION)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ------------------------------------------------------------------------------
# 11. BROWSER CACHING FOR STATIC ASSETS (HIGH PERFORMANCE)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 day"

    # Images & Media
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Dynamic Files (Never cache HTML, PHP or JSON API responses)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Ensure dynamic responses are never cached by proxy servers
<IfModule mod_headers.c>
    <FilesMatch "\.(php|html|json)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 12. CUSTOM ERROR MESSAGES
# ------------------------------------------------------------------------------
ErrorDocument 400 "400 Bad Request"
ErrorDocument 403 "403 Forbidden - Access Denied"
ErrorDocument 404 "404 Not Found - The requested page does not exist."
ErrorDocument 500 "500 Internal Server Error"

